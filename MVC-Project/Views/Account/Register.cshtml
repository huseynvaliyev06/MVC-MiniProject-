@model MVC_MiniProject.ViewModels.Account.RegisterVM
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register – eLearn</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background:#f0f2f5; min-height:100vh; display:flex; align-items:center; justify-content:center; }
        .auth-card { width:100%; max-width:460px; background:#fff; border-radius:16px; box-shadow:0 4px 24px rgba(0,0,0,.08); padding:40px 36px; }
        .auth-brand { font-size:1.5rem; font-weight:700; color:#1e2a3a; margin-bottom:28px; text-align:center; }
        .auth-brand span { color:#f97316; }
        .form-control:focus, .form-select:focus { border-color:#f97316; box-shadow:0 0 0 .2rem rgba(249,115,22,.15); }
        .btn-accent { background:#f97316; color:#fff; border:none; }
        .btn-accent:hover { background:#ea6c0a; color:#fff; }
    </style>
</head>
<body>
<div class="auth-card">
    <div class="auth-brand"><span>e</span>Learn</div>
    <h5 class="mb-1 fw-semibold">Create account</h5>
    <p class="text-muted small mb-4">Join the eLearning platform</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 small">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <div>@err.ErrorMessage</div> }
        </div>
    }

    <form asp-controller="Account" asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label fw-semibold small">Full Name</label>
            <input asp-for="FullName" class="form-control" placeholder="John Doe" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold small">Username</label>
            <input asp-for="UserName" class="form-control" placeholder="johndoe" autocomplete="username" />
            <span asp-validation-for="UserName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold small">Email</label>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold small">Password</label>
            <input asp-for="Password" class="form-control" type="password" placeholder="Min. 6 characters" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label class="form-label fw-semibold small">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Repeat password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <input type="hidden" name="Role" value="Member" />

        <button type="submit" class="btn btn-accent w-100 py-2 fw-semibold">Create Account</button>
    </form>

    <hr class="my-4" />
    <p class="text-center small text-muted mb-0">
        Already have an account?
        <a asp-controller="Account" asp-action="Login" class="text-warning fw-semibold">Sign in</a>
    </p>
    <p class="text-center small mt-2">
        <a asp-controller="Home" asp-action="Index" class="text-muted">← Back to site</a>
    </p>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
