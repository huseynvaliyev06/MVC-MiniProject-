@model AboutLeftAndRightVM
<div class="about" style="padding-top:120px;">
    <div class="container">
        <div class="row about_row row-lg-eq-height">
            <div class="col-lg-6">
                <div class="about_content">
                    <div class="about_title">@Model.AboutRight.Title</div>
                    <div class="about_text">
                        <p>@Model.AboutRight.Description</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="about_image"><img src="~/images/@Model.AboutRight.RightImage" alt="https://unsplash.com/jtylernix"></div>
            </div>
        </div>
        <div class="row about_row row-lg-eq-height">
            <div class="col-lg-6 order-lg-1 order-2">
                <div class="about_image"><img src="~/images/@Model.AboutLeft.LeftImage" alt=""></div>
            </div>
            <div class="col-lg-6 order-lg-2 order-1">
                <div class="about_content">
                    <div class="about_title">@Model.AboutLeft.Title</div>
                    <div class="about_text">
                        <p>@Model.AboutLeft.Description</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>