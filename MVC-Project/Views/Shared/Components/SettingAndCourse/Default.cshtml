@model SettingAndCourseVM
<div class="courses">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 offset-lg-1">
                <div class="section_title text-center"><h2>@(Model.Settings.ContainsKey("Courses") ? Model.Settings["Courses"] : "Our Courses")</h2></div>
                <div class="section_subtitle">@(Model.Settings.ContainsKey("CoursesDesc") ? Model.Settings["CoursesDesc"] : "")</div>
            </div>
        </div>

        <div class="row">
            <div class="col">
                <div class="course_search">
                    <form asp-controller="Course" asp-action="Index" method="get" class="course_search_form d-flex flex-md-row flex-column align-items-start justify-content-between">
                        <div><input type="text" name="searchText" class="course_input" placeholder="Course name" /></div>
                        <div><input type="text" class="course_input" placeholder="Level" /></div>
                        <button type="submit" class="course_button"><span>search course</span><span class="button_arrow"><i class="fa fa-angle-right" aria-hidden="true"></i></span></button>
                    </form>
                </div>
            </div>
        </div>

        <div class="row courses_row">

            @foreach (var item in Model.CourseInfos.OrderByDescending(m => m.SalesCount))
            {
                <div class="col-lg-4 col-md-6">
                    <div class="course">
                        <div class="course_image"><img src="~/images/@item.MainImage" alt="@item.Name"></div>
                        <div class="course_body">
                            <div class="course_header d-flex flex-row align-items-center justify-content-start">
                                @if (item.IsFeatured)
                                {
                                    <div class="course_tag"><a href="#">Featured</a></div>
                                }
                                else if (!string.IsNullOrEmpty(item.Tag))
                                {
                                    <div class="course_tag"><a href="#">@item.Tag</a></div>
                                }
                                <div class="course_price ml-auto">Price: <span>$@item.Price</span></div>
                            </div>
                            <div class="course_title"><h3><a asp-controller="Detail" asp-action="Index" asp-route-id="@item.Id">@item.Name</a></h3></div>
                            <div class="course_text">@item.Description</div>
                            <div class="course_footer d-flex align-items-center justify-content-start">
                                <div class="course_author_image"><img src="~/images/@item.AuthorImage" alt=""></div>
                                <div class="course_author_name">@item.TeacherName</div>
                                <div class="course_sales ml-auto"><span>@item.SalesCount</span> Sales</div>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="row">
            <div class="col">
                <div class="courses_paginations">
                    <ul>
                        <li class="active"><a href="#">01</a></li>
                        <li><a href="#">02</a></li>
                        <li><a href="#">03</a></li>
                        <li><a href="#">04</a></li>
                        <li><a href="#">05</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>