@model AdminNewsCreateVM
@{ ViewData["Title"] = "New News"; }

<div class="row justify-content-center"><div class="col-lg-6"><div class="page-card">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-area="Admin" asp-controller="News" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <h5 class="mb-0">New News</h5>
    </div>
    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Date</label>
            <input asp-for="Date" class="form-control" placeholder="e.g. 10 Jan 2026" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Author</label>
            <select asp-for="AuthorId" asp-items="ViewBag.Authors" class="form-select">
                <option value="">— Select Author —</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Image</label>
            <input asp-for="Image" class="form-control" type="file" accept="image/*" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent px-4"><i class="bi bi-check-lg me-1"></i>Save</button>
            <a asp-area="Admin" asp-controller="News" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div></div>
