@model IEnumerable<AdminNewsIndexVM>
@{ ViewData["Title"] = "News"; }
@{ bool canEdit = User.IsInRole("SuperAdmin"); }

<div class="page-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0"><i class="bi bi-newspaper me-2 text-success"></i>News</h5>
        @if (canEdit)
        {
            <a asp-area="Admin" asp-controller="News" asp-action="Create" class="btn btn-accent btn-sm"><i class="bi bi-plus-lg me-1"></i>New News</a>
        }
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead><tr><th>#</th><th>Image</th><th>Date</th><th>Description</th><th>Author</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td>@n.Id</td>
                    <td><img src="~/images/@n.Image" class="img-thumb" /></td>
                    <td>@n.Date</td>
                    <td>@(n.Description?.Length > 60 ? n.Description[..60] + "…" : n.Description)</td>
                    <td>@n.AuthorName</td>
                    <td class="d-flex gap-1">
                        @if (canEdit)
                        {
                            <a asp-area="Admin" asp-controller="News" asp-action="Edit" asp-route-id="@n.Id"
                               class="btn btn-sm btn-sm-icon btn-warning text-white"><i class="bi bi-pencil"></i></a>
                            <form asp-area="Admin" asp-controller="News" asp-action="Delete" asp-route-id="@n.Id" method="post"
                                  onsubmit="return confirm('Delete this news?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-sm-icon btn-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                        else { <span class="text-muted small">View only</span> }
                    </td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted py-3">No news found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
