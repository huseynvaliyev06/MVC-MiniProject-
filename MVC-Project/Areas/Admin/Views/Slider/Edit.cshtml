@model AdminSliderEditVM
@{ ViewData["Title"] = "Edit Slider"; }

<div class="row justify-content-center"><div class="col-lg-6"><div class="page-card">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-area="Admin" asp-controller="Slider" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <h5 class="mb-0">Edit Slider</h5>
    </div>
    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Banner Image</label>
            @if (!string.IsNullOrEmpty(Model.ExistingBanner))
            { <div class="mb-1"><img src="~/images/@Model.ExistingBanner" class="img-thumb" /> <span class="text-muted small">current</span></div> }
            <input asp-for="SliderBanner" class="form-control" type="file" accept="image/*" />
        </div>
        <div class="mb-3">
            <label class="form-label">Logo Image</label>
            @if (!string.IsNullOrEmpty(Model.ExistingLogo))
            { <div class="mb-1"><img src="~/images/@Model.ExistingLogo" class="img-thumb" /> <span class="text-muted small">current</span></div> }
            <input asp-for="Logo" class="form-control" type="file" accept="image/*" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent px-4"><i class="bi bi-check-lg me-1"></i>Update</button>
            <a asp-area="Admin" asp-controller="Slider" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div></div>
