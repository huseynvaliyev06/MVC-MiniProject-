@model AdminTeacherEditVM
@{ ViewData["Title"] = "Edit Teacher"; }

<div class="row justify-content-center"><div class="col-lg-6"><div class="page-card">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-area="Admin" asp-controller="Teacher" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <h5 class="mb-0">Edit Teacher</h5>
    </div>
    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="mb-3">
            <label class="form-label">Full Name *</label>
            <input asp-for="FullName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Position</label>
            <select asp-for="PositionId" asp-items="ViewBag.Positions" class="form-select"></select>
        </div>
        <div class="mb-3">
            <label class="form-label">Photo</label>
            @if (!string.IsNullOrEmpty(Model.ExistingImage))
            {
                <div class="mb-2">
                    <img src="~/images/@Model.ExistingImage" style="width:60px;height:60px;object-fit:cover;border-radius:50%" />
                    <span class="text-muted small ms-2">Current photo</span>
                </div>
            }
            <input asp-for="Image" class="form-control" type="file" accept="image/*" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent px-4"><i class="bi bi-check-lg me-1"></i>Update</button>
            <a asp-area="Admin" asp-controller="Teacher" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div></div>
