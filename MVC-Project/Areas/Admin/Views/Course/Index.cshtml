@model IEnumerable<AdminCourseIndexVM>
@{  ViewData["Title"] = "Courses"; }
@{ bool canEdit = User.IsInRole("SuperAdmin"); }

<div class="page-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0"><i class="bi bi-journal-bookmark me-2 text-warning"></i>Courses</h5>
        @if (canEdit)
        {
            <a asp-area="Admin" asp-controller="Course" asp-action="Create" class="btn btn-accent btn-sm">
                <i class="bi bi-plus-lg me-1"></i>New Course
            </a>
        }
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th><th>Name</th><th>Teacher</th>
                    <th>Price</th><th>Sales</th><th>Featured</th><th>Tag</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.TeacherName</td>
                    <td>$@item.Price</td>
                    <td>@item.SalesCount</td>
                    <td>@(item.IsFeatured ? "✓" : "—")</td>
                    <td>@(string.IsNullOrEmpty(item.Tag) ? "—" : item.Tag)</td>
                    <td class="d-flex gap-1">
                        @if (canEdit)
                        {
                            <a asp-area="Admin" asp-controller="Course" asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-sm-icon btn-warning text-white" title="Edit"><i class="bi bi-pencil"></i></a>
                            <form asp-area="Admin" asp-controller="Course" asp-action="Delete" asp-route-id="@item.Id" method="post"
                                  onsubmit="return confirm('Delete this course?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-sm-icon btn-danger" title="Delete"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">View only</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            { <tr><td colspan="8" class="text-center text-muted py-3">No courses found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
