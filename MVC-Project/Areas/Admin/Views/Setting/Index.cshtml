@model IEnumerable<Setting>
@{ ViewData["Title"] = "Settings"; }
@{ bool canEdit = User.IsInRole("SuperAdmin"); }

<div class="page-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Settings</h5>
        @if (canEdit)
        {
            <a asp-area="Admin" asp-controller="Setting" asp-action="Create" class="btn btn-accent btn-sm"><i class="bi bi-plus-lg me-1"></i>New Setting</a>
        }
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead><tr><th>#</th><th>Key</th><th>Value</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td><code>@s.Key</code></td>
                    <td>@(s.Value?.Length > 80 ? s.Value[..80] + "…" : s.Value)</td>
                    <td class="d-flex gap-1">
                        @if (canEdit)
                        {
                            <a asp-area="Admin" asp-controller="Setting" asp-action="Edit" asp-route-id="@s.Id"
                               class="btn btn-sm btn-sm-icon btn-warning text-white"><i class="bi bi-pencil"></i></a>
                            <form asp-area="Admin" asp-controller="Setting" asp-action="Delete" asp-route-id="@s.Id" method="post"
                                  onsubmit="return confirm('Delete this setting?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-sm-icon btn-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                        else { <span class="text-muted small">View only</span> }
                    </td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">No settings found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
