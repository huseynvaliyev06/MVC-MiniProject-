@model AdminEventEditVM
@{ ViewData["Title"] = "Edit Event"; }

<div class="row justify-content-center"><div class="col-lg-6"><div class="page-card">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-area="Admin" asp-controller="Event" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <h5 class="mb-0">Edit Event</h5>
    </div>
    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Day (number)</label>
                <input asp-for="Date" class="form-control" type="number" min="1" max="31" />
            </div>
            <div class="col-md-8">
                <label class="form-label">Month</label>
                <input asp-for="Month" class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-accent px-4"><i class="bi bi-check-lg me-1"></i>Update</button>
            <a asp-area="Admin" asp-controller="Event" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div></div>
