@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-journal-bookmark"></i>
                </div>
                <div>
                    <div style="font-size:1.6rem;font-weight:700;color:#333">@ViewBag.CourseCount</div>
                    <div style="font-size:.8rem;color:#888">Courses</div>
                </div>
                <a asp-area="Admin" asp-controller="Course" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-person-badge"></i>
                </div>
                <div>
                    <div style="font-size:1.6rem;font-weight:700;color:#333">@ViewBag.TeacherCount</div>
                    <div style="font-size:.8rem;color:#888">Teachers</div>
                </div>
                <a asp-area="Admin" asp-controller="Teacher" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-newspaper"></i>
                </div>
                <div>
                    <div style="font-size:1.6rem;font-weight:700;color:#333">@ViewBag.NewsCount</div>
                    <div style="font-size:.8rem;color:#888">News</div>
                </div>
                <a asp-area="Admin" asp-controller="News" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div>
                    <div style="font-size:1.6rem;font-weight:700;color:#333">@ViewBag.EventCount</div>
                    <div style="font-size:.8rem;color:#888">Events</div>
                </div>
                <a asp-area="Admin" asp-controller="Event" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-images"></i>
                </div>
                <div>
                    <div style="font-size:1.6rem;font-weight:700;color:#333">@ViewBag.SliderCount</div>
                    <div style="font-size:.8rem;color:#888">Sliders</div>
                </div>
                <a asp-area="Admin" asp-controller="Slider" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon bg-secondary bg-opacity-10 text-secondary">
                    <i class="bi bi-gear"></i>
                </div>
                <div>
                    <div style="font-size:1.6rem;font-weight:700;color:#333">@ViewBag.SettingCount</div>
                    <div style="font-size:.8rem;color:#888">Settings</div>
                </div>
                <a asp-area="Admin" asp-controller="Setting" asp-action="Index" class="stretched-link"></a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="page-card">
            <h5><i class="bi bi-grid-3x3-gap me-2 text-warning"></i>Quick Actions</h5>
            <div class="d-flex flex-wrap gap-2">
                <a asp-area="Admin" asp-controller="Course"  asp-action="Create" class="btn btn-accent btn-sm"><i class="bi bi-plus"></i> New Course</a>
                <a asp-area="Admin" asp-controller="Teacher" asp-action="Create" class="btn btn-accent btn-sm"><i class="bi bi-plus"></i> New Teacher</a>
                <a asp-area="Admin" asp-controller="Slider"  asp-action="Create" class="btn btn-accent btn-sm"><i class="bi bi-plus"></i> New Slider</a>
                <a asp-area="Admin" asp-controller="News"    asp-action="Create" class="btn btn-accent btn-sm"><i class="bi bi-plus"></i> New News</a>
                <a asp-area="Admin" asp-controller="Event"   asp-action="Create" class="btn btn-accent btn-sm"><i class="bi bi-plus"></i> New Event</a>
            </div>
        </div>
    </div>
</div>
