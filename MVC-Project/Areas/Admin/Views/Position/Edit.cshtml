@model AdminPositionEditVM
@{ ViewData["Title"] = "Edit Position"; }

<div class="row justify-content-center"><div class="col-lg-4"><div class="page-card">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a asp-area="Admin" asp-controller="Position" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <h5 class="mb-0">Edit Position</h5>
    </div>
    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div class="mb-3">
            <label class="form-label">Position Name *</label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent px-4"><i class="bi bi-check-lg me-1"></i>Update</button>
            <a asp-area="Admin" asp-controller="Position" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div></div></div>
