@model IEnumerable<Position>
@{ ViewData["Title"] = "Positions"; }
@{ bool canEdit = User.IsInRole("SuperAdmin"); }

<div class="page-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="mb-0"><i class="bi bi-briefcase me-2"></i>Positions</h5>
        @if (canEdit)
        {
            <a asp-area="Admin" asp-controller="Position" asp-action="Create" class="btn btn-accent btn-sm"><i class="bi bi-plus-lg me-1"></i>New Position</a>
        }
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead><tr><th>#</th><th>Name</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td><strong>@p.Name</strong></td>
                    <td class="d-flex gap-1">
                        @if (canEdit)
                        {
                            <a asp-area="Admin" asp-controller="Position" asp-action="Edit" asp-route-id="@p.Id"
                               class="btn btn-sm btn-sm-icon btn-warning text-white"><i class="bi bi-pencil"></i></a>
                            <form asp-area="Admin" asp-controller="Position" asp-action="Delete" asp-route-id="@p.Id" method="post"
                                  onsubmit="return confirm('Delete this position?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-sm-icon btn-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                        else { <span class="text-muted small">View only</span> }
                    </td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted py-3">No positions found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
